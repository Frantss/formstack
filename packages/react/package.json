{
  "name": "oxform-react",
  "version": "0.3.1",
  "description": "Oxform is a lean and flexible framework-agnostic form library.",
  "license": "MIT",
  "author": "Frantss <frantss.bongiovanni@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "imports": {
    "#array-field": "./src/array-field.tsx",
    "#field": "./src/field.tsx",
    "#subscribe": "./src/subscribe.tsx",
    "#use-form-effect": "./src/use-form-effect.ts",
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "test:dev": "vp test --watch",
    "check:types": "vp exec tsc --noEmit",
    "check:package": "vp exec node --max-old-space-size=4096 ../../node_modules/.bun/publint@0.3.16/node_modules/publint/src/cli.js --strict && vp exec node ../../node_modules/.bun/@arethetypeswrong+cli@0.18.2/node_modules/@arethetypeswrong/cli/dist/index.js --pack --no-emoji"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/react-store": "^0.11.0",
    "oxform-core": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "publint": "^0.3.16",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "^5.9.3",
    "vitest-browser-react": "^2.2.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
